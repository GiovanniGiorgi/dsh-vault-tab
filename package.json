{
  "name": "@local/dsh-vault-tab",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Right-sidebar tab with a second file tree rooted at a configured folder (Vault), plus an optional vault-setup skill that scaffolds or adopts that folder through the vault_setup tool",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "assets/*.md", "skills/*.md", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
