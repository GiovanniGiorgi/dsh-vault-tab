{
	"name": "@local/dsh-vault-tab",
	"version": "1.8.0",
	"private": true,
	"type": "module",
	"description": "Vault tab: list the configured vault folder, write into it with the vault_* tools (create, move with link upkeep, delete behind a link check), and a Vault Grant control in the composer.",
	"dependencies": {
		"@deepseek-ai/schemastery": "^3.18.5"
	},
	"exports": {
		".": "./index.js",
		"./client": "./client.js",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg"
	},
	"files": [
		"index.js",
		"client.js",
		"cordis.patch.yml",
		"locale/*.json",
		"assets/*.md",
		"skills/*.md",
		"icon.svg"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-sidebar-right"
			]
		}
	}
}
